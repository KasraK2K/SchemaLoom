{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [{ "type": "command", "command": "graphify hook-guard search" }]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [{ "type": "command", "command": "graphify hook-guard read" }]
      }
    ]
  }
}

{
  "name": "@schemaloom/orm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/prisma-schema-wasm": "7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@schemaloom/engine-sdk": "workspace:*",
    "@schemaloom/schema-model": "workspace:*"
  },
  "devDependencies": {
    "@schemaloom/config": "workspace:*",
    "@types/node": "^22.15.0",
    "drizzle-orm": "^0.45.3",
    "eslint": "catalog:",
    "prisma": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "catalog:",
    "typeorm": "^1.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

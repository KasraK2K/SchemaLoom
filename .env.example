# SchemaLoom — copy to .env and fill in. This file is the COMPLETE list:
# if a variable is not here, no task may read it.
#
# Credential changes are INIT-ONLY for postgres and minio: they are read when the
# data volume is first created. After changing one, `docker compose down -v`.

# ─── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Proxy hops in front of the api (1 behind one load balancer). 0 locally.
TRUST_PROXY=0

# ─── public URLs (required) ───────────────────────────────────────────────────
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated allow-list. Defaults to WEB_PUBLIC_URL.
# CORS_ORIGINS=http://localhost:3000

# ─── postgres (read by BOTH docker-compose and the api) ───────────────────────
POSTGRES_USER=schemaloom
POSTGRES_PASSWORD=schemaloom
POSTGRES_DB=schemaloom
POSTGRES_PORT=5432
# 127.0.0.1 rather than localhost where [::1] reaches a different Postgres.
POSTGRES_HOST=localhost
# DATABASE_URL is DERIVED from the four values above by src/config/env.ts.
# Set it explicitly only to point at a managed database.
# DATABASE_URL=postgresql://schemaloom:schemaloom@localhost:5432/schemaloom
DATABASE_URL_TEST=postgresql://schemaloom:schemaloom@localhost:5432/schemaloom_test
DATABASE_URL_E2E=postgresql://schemaloom:schemaloom@localhost:5432/schemaloom_e2e

# ─── redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# A DIFFERENT logical DB, so integration tests never share a keyspace or a queue
# with a running dev api.
REDIS_URL_TEST=redis://localhost:6379/1
REDIS_KEY_PREFIX=sl:

# ─── auth secrets (required; >=32 chars each) ─────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
# 32-byte base64. Encrypts TOTP secrets and recovery codes at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Applied ONLY to sl_presence and sl_csrf — never to sl_access or sl_refresh,
# which are host-only on the API origin. Leave it unset: the web app and the api share
# one hostname (docs/deploy.md), so every cookie can stay host-only.
# COOKIE_DOMAIN=
# COOKIE_SECURE defaults to NODE_ENV === 'production'.
# COOKIE_SECURE=false

# Who may create an account (docs/phase16/DESIGN.md). `invite` (the default): the first
# account signs up freely and becomes the owner; everyone after needs an invitation
# (Settings → Members). `open`: anyone can sign up, for a hosted service.
SIGNUP_MODE=invite

# ─── OAuth (both-or-neither per provider; omit to hide the button) ────────────
# Phase 1 ships ONE provider. Google is wired; GitHub is Phase 3.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── mail (Mailgun or SMTP_URL — boot fails if neither is set) ────────────────
# Mailgun wins when its key and domain are both set; locally SMTP goes to mailpit.
MAIL_FROM=SchemaLoom <no-reply@schemaloom.local>
SMTP_URL=smtp://localhost:1025
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# EU-region domains: https://api.eu.mailgun.net
# MAILGUN_API_URL=https://api.mailgun.net

# ─── object storage (also read by docker-compose as MinIO root creds) ─────────
S3_ENDPOINT=http://localhost:9900
S3_BUCKET=schemaloom
S3_ACCESS_KEY_ID=schemaloom
S3_SECRET_ACCESS_KEY=schemaloom-dev-secret
# S3_PUBLIC_URL defaults to S3_ENDPOINT.
# S3_PUBLIC_URL=http://localhost:9900
MINIO_PORT=9900
MINIO_CONSOLE_PORT=9901

# ─── mailpit ──────────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-component fetches; lets RSC reach the API over a private address in prod.
# API_INTERNAL_URL=http://localhost:3001

# ─── e2e ──────────────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001

# ─── AI (Phase 5; without a key every AI route answers 503) ───────────────────
# ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5; claude-opus-5-5 for harder questions at twice the price.
# AI_MODEL=claude-sonnet-5-5

# ─── Read a database (Phase 6) ────────────────────────────────────────────────
# The api runs pg_dump. The api image has it (`docker compose up -d`);
# only `pnpm dev` needs a local PostgreSQL client, or PG_DUMP_PATH pointing at one.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# Private/internal hosts are refused unless this is true. Dev reads the docker Postgres, so
# it's on here; on the hosted service keep it false.
INTROSPECT_ALLOW_PRIVATE_HOSTS=true
# INTROSPECTION_ENABLED=true
# SQLite projects upload the .db file; only its schema is read. Bytes, default 100 MB.
# INTROSPECT_UPLOAD_MAX_BYTES=100000000

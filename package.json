{
  "name": "schemaloom",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:int": "turbo test:int",
    "test:e2e": "turbo test:e2e",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "infra:up": "docker compose up -d postgres redis minio mailpit",
    "infra:down": "docker compose down",
    "app:up": "docker compose up -d --build",
    "app:down": "docker compose down",
    "app:logs": "docker compose logs -f migrate api web proxy",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.0",
    "typescript": "catalog:"
  }
}

{
  "name": "@schemaloom/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@schemaloom/contracts": "workspace:*",
    "@schemaloom/schema-model": "workspace:*",
    "zod": "catalog:",
    "dotenv": "^17.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@schemaloom/engine-sdk": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "nestjs-zod": "^5.5.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@schemaloom/config": "workspace:*",
    "eslint": "catalog:",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.15.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "pino-pretty": "^13.0.0"
  }
